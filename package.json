{
  "name": "bossa-nova-restaurant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:create:dev": "dotenvx run --env-file=.env.development npx tsx src/app/_database/scripts/createDB.ts",
    "db:create:prod": "dotenvx run --env-file=.env.production npx tsx src/app/_database/scripts/createDB.ts",
    "db:script:execute:dev": "dotenvx run --env-file=.env.development npx tsx src/app/_database/scripts/${SCRIPT_NAME}.ts",
    "db:script:execute:prod": "dotenvx run --env-file=.env.production npx tsx src/app/_database/scripts/${SCRIPT_NAME}.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "next": "^16.0.7",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.5.8",
    "radix-ui": "^1.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "eslint-config-prettier": "^10.1.8",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
